# ─── Supabase ────────────────────────────────────────────────────────────────
# URL do projeto (Project Settings -> API -> Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# CHAVE service_role (Project Settings -> API -> service_role secret).
# ⚠️ NUNCA exponha essa chave no painel/Lovable. Ela fica SÓ aqui na VM.
SUPABASE_SERVICE_KEY=eyJ...

# ─── Robô ProAutoMax ─────────────────────────────────────────────────────────
# Pasta onde estão main.py / main_tarde.py / drivers / rotinas.json
PROJECT_DIR=C:\ProAutoMax
# Python que tem as dependências do robô (use o do venv, ex:
#   C:\ProAutoMax\.venv\Scripts\python.exe)
PYTHON_BIN=C:\ProAutoMax\.venv\Scripts\python.exe

SCRIPT_MANHA=main.py
SCRIPT_TARDE=main_tarde.py

# Arquivos JSON que cada script lê (ficam na raiz do PROJECT_DIR)
JSON_MANHA=rotinas.json
JSON_TARDE=rotinas_tarde.json

# ─── Comportamento ───────────────────────────────────────────────────────────
# Antes de cada run, regenerar o rotinas.json a partir da tabela 'routines'
# (do Supabase). Com 'true', o toggle ativo/inativo do PAINEL passa a mandar
# na execução — o painel vira a fonte da verdade. Faz backup .bak antes de
# sobrescrever e, se a tabela vier vazia, mantém o JSON atual do disco.
# Coloque 'false' se quiser continuar editando o rotinas.json na mão.
SYNC_ROTINAS_JSON=true

# ─── Comportamento ───────────────────────────────────────────────────────────
# De quantos em quantos segundos checar a fila do Supabase
POLL_SECONDS=5
# Agendador interno (lê a tabela 'schedules' e enfileira no horário).
# Deixe 'true' para agendar tudo pelo Python.
# Coloque 'false' se for agendar por fora (n8n / Power Automate /
# Agendador de Tarefas) — nesse caso a ferramenta externa só insere uma
# linha em 'runs' com status='queued'.
ENABLE_SCHEDULER=true

# Janela de tolerância do agendador (em minutos): se o agente estava parado
# no minuto exato do horário, ele ainda dispara se voltar dentro dessa janela
# e não tiver rodado o agendamento hoje. 0 = só no minuto exato.
AGENDADOR_TOLERANCIA_MIN=10
